        <Geometry x:Key="IconX">M18 6 6 18 M6 6l12 12</Geometry>
        <Geometry x:Key="IconCheck">M20 6 9 17l-5-5</Geometry>
        <Geometry x:Key="IconPlus">M12 5v14 M5 12h14</Geometry>
        <Geometry x:Key="IconLock">M5 11a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z M8 11V7a4 4 0 1 1 8 0v4</Geometry>
