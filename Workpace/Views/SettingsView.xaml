<UserControl
    x:Class="Workpace.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F8F7FF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32">

            <!--  제목  -->
            <TextBlock
                Margin="0,0,0,32"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#1F1F1F"
                Text="설정" />

            <!--  ① 프로필 설정  -->
            <Border
                Margin="0,0,0,16"
                Padding="24"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1F1F1F"
                        Text="프로필 설정" />

                    <!--  이름  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="이름 *" />
                    <TextBox
                        Height="36"
                        Margin="0,0,0,16"
                        Padding="10,8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  이메일  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="이메일" />
                    <TextBox
                        Height="36"
                        Margin="0,0,0,16"
                        Padding="10,8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  GitHub  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="GitHub" />
                    <TextBox
                        Height="36"
                        Margin="0,0,0,16"
                        Padding="10,8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Text="{Binding GitHub, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  블로그  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="블로그" />
                    <TextBox
                        Height="36"
                        Margin="0,0,0,16"
                        Padding="10,8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Text="{Binding Blog, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  LinkedIn  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="LinkedIn" />
                    <TextBox
                        Height="36"
                        Margin="0,0,0,16"
                        Padding="10,8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Text="{Binding LinkedIn, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  한 줄 자기소개  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="한 줄 자기소개" />
                    <TextBox
                        Height="60"
                        Margin="0,0,0,20"
                        Padding="10,8"
                        AcceptsReturn="True"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <!--  저장 버튼  -->
                    <Button
                        Width="120"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="#7C3AED"
                        BorderThickness="0"
                        Command="{Binding SaveCommand}"
                        Content="저장"
                        Cursor="Hand"
                        Foreground="White" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>