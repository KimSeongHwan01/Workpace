<Window
    x:Class="Workpace.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Workpace"
    Width="1280"
    Height="768"
    MinWidth="900"
    MinHeight="600"
    Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  왼쪽 사이드바  -->
        <Border
            Grid.Column="0"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,1,0">

            <!--  Grid로 교체 — 상단/중간/하단 영역을 명확하게 분리  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  로고  -->
                    <RowDefinition Height="Auto" />
                    <!--  네비게이션  -->
                    <RowDefinition Height="Auto" />
                    <!--  내 프로젝트 헤더  -->
                    <RowDefinition Height="*" />
                    <!--  프로젝트 목록 — 남은 공간 차지  -->
                    <RowDefinition Height="Auto" />
                    <!--  핵심 기능  -->
                    <RowDefinition Height="Auto" />
                    <!--  스트릭  -->
                    <RowDefinition Height="Auto" />
                    <!--  포트폴리오 버튼  -->
                </Grid.RowDefinitions>

                <!--  로고  -->
                <Border Grid.Row="0" Padding="20,24,20,16">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="32"
                            Height="32"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="W" />
                        </Border>
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#1F1F1F"
                            Text="Workpace" />
                    </StackPanel>
                </Border>

                <!--  네비게이션 메뉴  -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button Command="{Binding GoToStatisticsCommand}" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                FontSize="16"
                                Text="📊" />
                            <TextBlock Text="통계" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoToSettingsCommand}" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                FontSize="16"
                                Text="⚙" />
                            <TextBlock Text="설정" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  내 프로젝트 헤더  -->
                <DockPanel Grid.Row="2" Margin="20,20,20,8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="#9CA3AF"
                        Text="내 프로젝트" />
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding AddProjectCommand}"
                        Content="+"
                        Cursor="Hand"
                        DockPanel.Dock="Right"
                        FontSize="18"
                        Foreground="{StaticResource PrimaryBrush}" />
                </DockPanel>

                <!--  프로젝트 목록  -->
                <ListBox
                    x:Name="ProjectListBox"
                    Grid.Row="3"
                    Margin="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Projects}"
                    MouseLeftButtonUp="ProjectListBox_MouseLeftButtonUp"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay}">

                    <!--  ListBoxItem 자체에 ContextMenu 붙이기  -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Foreground="#EF4444"
                                            Header="삭제" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--  Border에서 ContextMenu 제거, Background만 유지  -->
                            <Border
                                Padding="12,10"
                                Background="Transparent"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Foreground="#1F1F1F"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="#9CA3AF"
                                        Text="진행중" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  핵심 기능 현황  -->
                <Border
                    Grid.Row="4"
                    Margin="12,8,12,4"
                    Padding="12"
                    Background="#F5F3FF"
                    BorderBrush="#DDD6FE"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="핵심 기능 🔒" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="{Binding CoreTaskCount, StringFormat={}{0} / 3개}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding CoreTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="✅"
                                            Visibility="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter=완료}" />
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="🔒"
                                            Visibility="{Binding Status, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#374151"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Text="카드의 🔒 버튼으로 지정하세요"
                            Visibility="{Binding CoreTasks.Count, Converter={StaticResource EqualityConverter}, ConverterParameter=0}" />
                    </StackPanel>
                </Border>

                <!--  스트릭  -->
                <Border
                    Grid.Row="5"
                    Margin="12,4,12,4"
                    Padding="12"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#EA580C"
                                Text="🔥 연속 집중" />
                            <TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#EA580C"
                                Text="{Binding CurrentStreak, StringFormat={}{0}일}" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Text="오늘 Task를 완료하면 기록돼요" />
                    </StackPanel>
                </Border>

                <!--  포트폴리오 추출 버튼  -->
                <Border Grid.Row="6" Padding="12,8">
                    <Button
                        Height="48"
                        Background="{StaticResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding GoToPortfolioCommand}"
                        Content="📄 포트폴리오 추출 ✨"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="White" />
                </Border>

            </Grid>
        </Border>

        <!--  오른쪽 콘텐츠 영역  -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />

    </Grid>
</Window>