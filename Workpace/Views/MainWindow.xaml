<Window x:Class="Workpace.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workpace" Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <!-- 전체 레이아웃: 왼쪽 사이드바 240px + 오른쪽 콘텐츠 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────────────────────────────────────
             왼쪽 사이드바
             ─────────────────────────────────────── -->
        <Border Grid.Column="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 로고 영역 -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8" Width="32" Height="32">
                            <TextBlock Text="W" Foreground="White"
                                       FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Workpace" FontSize="18"
                                   FontWeight="Bold" Margin="10,0,0,0"
                                   Foreground="#1F1F1F"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 네비게이션 메뉴 -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0">
                    <!-- 내 워크스페이스 버튼 -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding GoToWorkspaceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="내 워크스페이스"/>
                        </StackPanel>
                    </Button>

                    <!-- 통계 버튼 -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding GoToStatisticsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="통계"/>
                        </StackPanel>
                    </Button>

                    <!-- 설정 버튼 -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding GoToSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="설정"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 내 프로젝트 목록 -->
                <DockPanel DockPanel.Dock="Top" Margin="20,20,20,8">
                    <TextBlock Text="내 프로젝트" FontSize="12"
                               Foreground="#9CA3AF" FontWeight="Medium"/>
                    <!-- 프로젝트 추가 버튼 -->
                    <Button DockPanel.Dock="Right" Content="+"
                            FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding AddProjectCommand}"/>
                </DockPanel>

                <!-- 프로젝트 목록 — DB에서 불러온 Projects에 바인딩 -->
                <ListBox ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" CornerRadius="8">
                                <StackPanel>
                                    <!-- 프로젝트 이름 -->
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14" FontWeight="Medium"
                                               Foreground="#1F1F1F"/>
                                    <!-- D-day + 진행률 -->
                                    <TextBlock FontSize="12" Foreground="#9CA3AF"
                                               Margin="0,2,0,0"
                                               Text="진행중"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 포트폴리오 추출 버튼 — 하단 고정 -->
                <Border DockPanel.Dock="Bottom" Padding="16">
                    <Button Background="{StaticResource PrimaryBrush}"
                            Foreground="White" Height="48"
                            FontSize="14" FontWeight="Medium"
                            BorderThickness="0"
                            Content="📄 포트폴리오 추출 ✨"
                            Cursor="Hand"/>
                </Border>

            </DockPanel>
        </Border>

        <!-- ───────────────────────────────────────
             오른쪽 콘텐츠 영역 — 나중에 칸반/통계/설정으로 교체
             ─────────────────────────────────────── -->
        <!-- 오른쪽 콘텐츠 영역 — CurrentView에 따라 화면 자동 전환 -->
        <ContentControl Grid.Column="1"
                Content="{Binding CurrentView}"/>

    </Grid>
</Window>