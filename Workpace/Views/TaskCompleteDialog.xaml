<Window
    x:Class="Workpace.Views.TaskCompleteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="작업 완료"
    Width="480"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28">

        <!--  완료 타이틀  -->
        <!--  완료 타이틀  -->
        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
            <Viewbox
                Width="20"
                Height="20"
                Margin="0,0,8,0">
                <Canvas Width="24" Height="24">
                    <Path
                        Data="{StaticResource IconCheckCircle}"
                        Fill="Transparent"
                        Stroke="#10B981"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2" />
                </Canvas>
            </Viewbox>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#1F1F1F"
                Text="작업 완료!" />
        </StackPanel>
        <TextBlock
            Margin="0,8,0,20"
            FontSize="13"
            Foreground="#6B7280"
            Text="{Binding TaskTitle}" />

        <!--  ── 이슈 입력 영역 ──  -->
        <TextBlock
            Margin="0,0,0,8"
            FontSize="13"
            FontWeight="SemiBold">
            이슈가 있었나요?&#160;&#160;<Run FontSize="11" Foreground="#999">(없으면 비워두세요)</Run>
        </TextBlock>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#666">
                문제
            </TextBlock>
            <TextBox
                Grid.Column="1"
                Padding="6,4"
                FontSize="12"
                Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#666">
                원인
            </TextBlock>
            <TextBox
                Grid.Column="1"
                Padding="6,4"
                FontSize="12"
                Text="{Binding Cause, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#666">
                해결
            </TextBlock>
            <TextBox
                Grid.Column="1"
                Padding="6,4"
                FontSize="12"
                Text="{Binding Solution, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--  ── 커밋 타입 선택 ──  -->
        <TextBlock
            Margin="0,0,0,10"
            FontSize="13"
            FontWeight="SemiBold">
            커밋 타입 선택
        </TextBlock>

        <ItemsControl ItemsSource="{Binding CommitTypes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton
                        Margin="0,4"
                        Command="{Binding DataContext.SelectCommitTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        GroupName="CommitType"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <!--  커밋 타입 태그  -->
                            <Border
                                Margin="0,0,8,0"
                                Padding="6,2"
                                Background="#EDE9FE"
                                CornerRadius="4">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#7C3AED"
                                    Text="{Binding Type}" />
                            </Border>
                            <!--  설명  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#444"
                                Text="{Binding Description}" />
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  ── 커밋 메시지 미리보기 ──  -->
        <TextBlock
            Margin="0,20,0,8"
            FontSize="13"
            FontWeight="SemiBold">
            커밋 메시지
        </TextBlock>

        <Border
            Padding="12,10"
            Background="#F5F3FF"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="#7C3AED"
                    Text="{Binding CommitMessage}" />

                <Button
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CopyCommitMessageCommand}"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="8,4"
                                Background="Transparent"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path
                                                Data="{StaticResource IconClipboard}"
                                                Fill="Transparent"
                                                Stroke="{StaticResource PrimaryBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="2" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="복사" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EDE9FE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!--  ── 하단 버튼 ──  -->
        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="38"
                Margin="0,0,6,0"
                Background="#F3F4F6"
                BorderThickness="0"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="취소"
                Cursor="Hand"
                FontSize="13">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button
                Grid.Column="1"
                Height="38"
                Margin="6,0,0,0"
                Background="{StaticResource PrimaryBrush}"
                BorderThickness="0"
                Command="{Binding ConfirmCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="완료"
                Cursor="Hand"
                FontSize="13"
                Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </StackPanel>
</Window>