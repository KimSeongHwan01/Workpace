<UserControl
    x:Class="Workpace.Views.CustomDatePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <Grid>
        <Border
            x:Name="Bd"
            MinHeight="36"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8"
            Cursor="Hand"
            MouseLeftButtonUp="Border_MouseLeftButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <!--  날짜 미선택 플레이스홀더  -->
                <TextBlock
                    x:Name="Placeholder"
                    Grid.Column="0"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#9CA3AF"
                    IsHitTestVisible="False"
                    Text="날짜를 선택하세요" />

                <!--  날짜 선택 후 표시  -->
                <TextBlock
                    x:Name="DateDisplay"
                    Grid.Column="0"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#111827"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

                <!--  달력 아이콘  -->
                <Viewbox
                    Grid.Column="1"
                    Width="15"
                    Height="15"
                    IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{StaticResource IconCalendar}"
                            Fill="Transparent"
                            Stroke="#9CA3AF"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>

        <!--  달력 팝업  -->
        <Popup
            x:Name="CalendarPopup"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=Bd}"
            StaysOpen="False">
            <Border
                Margin="0,4,0,0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="16"
                        Direction="270"
                        Opacity="0.1"
                        ShadowDepth="4"
                        Color="#000000" />
                </Border.Effect>
                <Calendar
                    x:Name="Cal"
                    Margin="8"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedDatesChanged="Cal_SelectedDatesChanged" />
            </Border>
        </Popup>
    </Grid>
</UserControl>