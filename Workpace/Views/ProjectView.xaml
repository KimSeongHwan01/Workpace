<UserControl
    x:Class="Workpace.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Workpace.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--  최상위 Grid: 칸반영역 | 상세패널 2컬럼  -->
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  ▼ 왼쪽: 기존 칸반 영역 전체  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  1. 헤더 영역  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,16"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="{Binding CurrentProject.Name}" />
                <Border
                    Margin="12,0,0,0"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="#F3F4F6"
                    CornerRadius="6">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding DDayText}" />
                </Border>
            </StackPanel>

            <!--  2. 진행률 영역  -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock
                        Width="80"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="현재 진행률:" />
                    <TextBlock
                        Width="40"
                        DockPanel.Dock="Right"
                        FontSize="13"
                        Foreground="#1F1F1F"
                        Text="{Binding CurrentProgressText}"
                        TextAlignment="Right" />
                    <ProgressBar
                        Height="8"
                        Background="#E5E7EB"
                        Foreground="{StaticResource PrimaryBrush}"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding CurrentProgress}" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock
                        Width="80"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="목표 진행률:" />
                    <TextBlock
                        Width="40"
                        DockPanel.Dock="Right"
                        FontSize="13"
                        Foreground="#1F1F1F"
                        Text="{Binding TargetProgressText}"
                        TextAlignment="Right" />
                    <ProgressBar
                        Height="8"
                        Background="#E5E7EB"
                        Foreground="#9CA3AF"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding TargetProgress}" />
                </DockPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#EF4444"
                    Text="{Binding PaceWarningText}" />
            </StackPanel>

            <!--  3. 단계 표시  -->
            <StackPanel
                Grid.Row="2"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                    <!--  기획  -->
                    <Ellipse
                        Width="28"
                        Height="28"
                        Fill="{Binding IsStage1Done, Converter={StaticResource BoolToStageColorConverter}}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{Binding IsStage1Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                        Text="기획" />
                    <Rectangle
                        Width="40"
                        Height="2"
                        Margin="8,0"
                        Fill="{Binding IsStage1Done, Converter={StaticResource BoolToStageColorConverter}}" />

                    <!--  설계  -->
                    <Ellipse
                        Width="28"
                        Height="28"
                        Fill="{Binding IsStage2Done, Converter={StaticResource BoolToStageColorConverter}}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{Binding IsStage2Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                        Text="설계" />
                    <Rectangle
                        Width="40"
                        Height="2"
                        Margin="8,0"
                        Fill="{Binding IsStage2Done, Converter={StaticResource BoolToStageColorConverter}}" />

                    <!--  개발  -->
                    <Ellipse
                        Width="28"
                        Height="28"
                        Fill="{Binding IsStage3Done, Converter={StaticResource BoolToStageColorConverter}}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{Binding IsStage3Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                        Text="개발" />
                    <Rectangle
                        Width="40"
                        Height="2"
                        Margin="8,0"
                        Fill="{Binding IsStage3Done, Converter={StaticResource BoolToStageColorConverter}}" />

                    <!--  테스트  -->
                    <Ellipse
                        Width="28"
                        Height="28"
                        Fill="{Binding IsStage4Done, Converter={StaticResource BoolToStageColorConverter}}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{Binding IsStage4Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                        Text="테스트" />
                    <Rectangle
                        Width="40"
                        Height="2"
                        Margin="8,0"
                        Fill="{Binding IsStage4Done, Converter={StaticResource BoolToStageColorConverter}}" />

                    <!--  배포  -->
                    <Ellipse
                        Width="28"
                        Height="28"
                        Fill="{Binding IsStage5Done, Converter={StaticResource BoolToStageColorConverter}}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{Binding IsStage5Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                        Text="배포" />

                </StackPanel>
            </StackPanel>

            <!--  4. 탭 필터  -->
            <Border
                Grid.Row="3"
                Margin="0,0,0,16"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding FilterCommand}"
                        CommandParameter="전체"
                        Content="전체" />
                    <Button
                        Command="{Binding FilterCommand}"
                        CommandParameter="기획"
                        Content="기획" />
                    <Button
                        Command="{Binding FilterCommand}"
                        CommandParameter="설계"
                        Content="설계" />
                    <Button
                        Command="{Binding FilterCommand}"
                        CommandParameter="개발"
                        Content="개발" />
                    <Button
                        Command="{Binding FilterCommand}"
                        CommandParameter="테스트"
                        Content="테스트" />
                    <Button
                        Command="{Binding FilterCommand}"
                        CommandParameter="배포"
                        Content="배포" />
                </StackPanel>
            </Border>

            <!--  5. 칸반 보드  -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  할일 컬럼  -->
                <StackPanel
                    Grid.Column="0"
                    AllowDrop="True"
                    Drop="Column_Drop"
                    Tag="할일">
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#1F1F1F"
                            Text="할일" />
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#9CA3AF"
                            Text="{Binding TodoTasks.Count}" />
                    </StackPanel>
                    <ListBox
                        MaxHeight="400"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding TodoTasks}"
                        PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="ListBox_PreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                Foreground="#EF4444"
                                                Header="삭제" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <!--  카드 상단: 제목 + 🔒 토글 버튼  -->
                                        <DockPanel Margin="0,0,0,4">
                                            <!--  🔒 핵심 기능 토글 버튼  -->
                                            <!--  IsCore=true면 보라색, false면 회색으로 표시  -->
                                            <Button
                                                Padding="4,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleCoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding IsCore, Converter={StaticResource BoolToLockIconConverter}}"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right"
                                                FontSize="14"
                                                Foreground="{Binding IsCore, Converter={StaticResource BoolToLockColorConverter}}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="#1F1F1F"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#9CA3AF"
                                            Text="{Binding Priority}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        Height="36"
                        Margin="0,8,0,0"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Command="{Binding AddTaskCommand}"
                        CommandParameter="할일"
                        Content="+ 작업 추가"
                        Cursor="Hand"
                        Foreground="#9CA3AF" />
                </StackPanel>

                <!--  진행중 컬럼  -->
                <StackPanel
                    Grid.Column="2"
                    AllowDrop="True"
                    Drop="Column_Drop"
                    Tag="진행중">
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#1F1F1F"
                            Text="진행중" />
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#9CA3AF"
                            Text="{Binding InProgressTasks.Count}" />
                    </StackPanel>
                    <ListBox
                        MaxHeight="400"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding InProgressTasks}"
                        PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="ListBox_PreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                Foreground="#EF4444"
                                                Header="삭제" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <!--  카드 상단: 제목 + 🔒 토글 버튼  -->
                                        <DockPanel Margin="0,0,0,4">
                                            <!--  🔒 핵심 기능 토글 버튼  -->
                                            <!--  IsCore=true면 보라색, false면 회색으로 표시  -->
                                            <Button
                                                Padding="4,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleCoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding IsCore, Converter={StaticResource BoolToLockIconConverter}}"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right"
                                                FontSize="14"
                                                Foreground="{Binding IsCore, Converter={StaticResource BoolToLockColorConverter}}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="#1F1F1F"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#9CA3AF"
                                            Text="{Binding Priority}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        Height="36"
                        Margin="0,8,0,0"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Command="{Binding AddTaskCommand}"
                        CommandParameter="진행중"
                        Content="+ 작업 추가"
                        Cursor="Hand"
                        Foreground="#9CA3AF" />
                </StackPanel>

                <!--  완료 컬럼  -->
                <StackPanel
                    Grid.Column="4"
                    AllowDrop="True"
                    Drop="Column_Drop"
                    Tag="완료">
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#1F1F1F"
                            Text="완료" />
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#9CA3AF"
                            Text="{Binding DoneTasks.Count}" />
                    </StackPanel>
                    <ListBox
                        MaxHeight="400"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding DoneTasks}"
                        PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="ListBox_PreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                Foreground="#EF4444"
                                                Header="삭제" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <!--  카드 상단: 제목 + 🔒 토글 버튼  -->
                                        <DockPanel Margin="0,0,0,4">
                                            <!--  🔒 핵심 기능 토글 버튼  -->
                                            <!--  IsCore=true면 보라색, false면 회색으로 표시  -->
                                            <Button
                                                Padding="4,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleCoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding IsCore, Converter={StaticResource BoolToLockIconConverter}}"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right"
                                                FontSize="14"
                                                Foreground="{Binding IsCore, Converter={StaticResource BoolToLockColorConverter}}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="#1F1F1F"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#9CA3AF"
                                            Text="{Binding Priority}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        Height="36"
                        Margin="0,8,0,0"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Command="{Binding AddTaskCommand}"
                        CommandParameter="완료"
                        Content="+ 작업 추가"
                        Cursor="Hand"
                        Foreground="#9CA3AF" />
                </StackPanel>
            </Grid>
        </Grid>
        <!--  ▲ 왼쪽 끝  -->

        <!--  ▼ 오른쪽: 작업 상세 패널  -->
        <Border
            Grid.Column="1"
            Width="280"
            Margin="16,0,0,0"
            Padding="0"
            VerticalAlignment="Top"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">

                    <!--  헤더: 작업 상세 + 닫기 버튼  -->
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1F1F1F"
                            Text="작업 상세" />
                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseDetailPanelCommand}"
                            Content="✕"
                            Cursor="Hand"
                            DockPanel.Dock="Right"
                            FontSize="16"
                            Foreground="#9CA3AF" />
                    </DockPanel>

                    <!--  수정 버튼 (보기 모드일 때만 표시)  -->
                    <Button
                        Margin="0,0,0,12"
                        Padding="8,4"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Command="{Binding StartEditCommand}"
                        Content="✏ 수정"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="#6B7280"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                    <!--  ── 보기 모드 ──  -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                        <!--  제목  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="제목" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="15"
                            FontWeight="Medium"
                            Foreground="#1F1F1F"
                            Text="{Binding SelectedTask.Title}"
                            TextWrapping="Wrap" />

                        <!--  상태  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="상태" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="14"
                            Foreground="#1F1F1F"
                            Text="{Binding SelectedTask.Status}" />

                        <!--  우선순위  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="우선순위" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="14"
                            Foreground="#1F1F1F"
                            Text="{Binding SelectedTask.Priority}" />

                        <!--  단계  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="단계" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="14"
                            Foreground="#1F1F1F"
                            Text="{Binding SelectedTask.Stage}" />

                        <!--  마감일  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="마감일" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="14"
                            Foreground="#1F1F1F"
                            Text="{Binding SelectedTask.DueDate, StringFormat=yyyy-MM-dd}" />
                    </StackPanel>

                    <!--  ── 수정 모드 ──  -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!--  제목  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="제목" />
                        <TextBox
                            Height="32"
                            Margin="0,0,0,12"
                            Padding="8,6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  우선순위  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="우선순위" />
                        <ComboBox
                            Height="32"
                            Margin="0,0,0,12"
                            SelectedValue="{Binding EditPriority}"
                            SelectedValuePath="Content">
                            <ComboBoxItem Content="높음" />
                            <ComboBoxItem Content="보통" />
                            <ComboBoxItem Content="낮음" />
                        </ComboBox>

                        <!--  단계  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="단계" />
                        <ComboBox
                            Height="32"
                            Margin="0,0,0,12"
                            SelectedValue="{Binding EditStage}"
                            SelectedValuePath="Content">
                            <ComboBoxItem Content="기획" />
                            <ComboBoxItem Content="설계" />
                            <ComboBoxItem Content="개발" />
                            <ComboBoxItem Content="테스트" />
                            <ComboBoxItem Content="완료" />
                        </ComboBox>

                        <!--  마감일  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="마감일" />
                        <DatePicker
                            Height="32"
                            Margin="0,0,0,16"
                            SelectedDate="{Binding EditDueDate}" />

                        <!--  저장 / 취소 버튼  -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Height="36"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Command="{Binding CancelEditCommand}"
                                Content="취소"
                                Cursor="Hand"
                                Foreground="#6B7280" />
                            <Button
                                Grid.Column="2"
                                Height="36"
                                Background="#7C3AED"
                                BorderThickness="0"
                                Command="{Binding SaveEditCommand}"
                                Content="저장"
                                Cursor="Hand"
                                Foreground="White" />
                        </Grid>
                    </StackPanel>

                    <!--  구분선  -->
                    <Rectangle
                        Height="1"
                        Margin="0,4,0,16"
                        Fill="#E5E7EB" />

                    <!--  연결된 파일 헤더  -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#1F1F1F"
                            Text="연결된 파일" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="{Binding CurrentFiles.Count, StringFormat=({0}개)}" />
                    </DockPanel>

                    <!--  파일 목록  -->
                    <ItemsControl ItemsSource="{Binding CurrentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="10"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <DockPanel>
                                        <!--  파일 아이콘  -->
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="📄" />
                                        <!--  삭제 버튼  -->
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="✕"
                                            Cursor="Hand"
                                            DockPanel.Dock="Right"
                                            FontSize="11"
                                            Foreground="#EF4444" />
                                        <!--  파일 이름 — 클릭하면 열기  -->
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            FontSize="12"
                                            Foreground="#374151"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="LeftClick" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  파일 추가 버튼  -->
                    <Button
                        Height="36"
                        Margin="0,4,0,0"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Command="{Binding AddFileCommand}"
                        Content="+ 파일 추가"
                        Cursor="Hand"
                        Foreground="#9CA3AF" />

                    <!--  구분선  -->
                    <Rectangle
                        Height="1"
                        Margin="0,16,0,16"
                        Fill="#E5E7EB" />

                    <!--  이슈 기록 헤더  -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#1F1F1F"
                            Text="이슈 기록" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="{Binding CurrentIssues.Count, StringFormat=({0}건)}" />
                    </DockPanel>

                    <!--  기존 이슈 목록  -->
                    <ItemsControl ItemsSource="{Binding CurrentIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="#FFF7ED"
                                    BorderBrush="#FED7AA"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <!--  날짜 + 삭제 버튼  -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding CreatedAt, StringFormat=yyyy.MM.dd}" />
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DeleteIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="삭제"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right"
                                                FontSize="11"
                                                Foreground="#EF4444" />
                                        </DockPanel>
                                        <!--  문제  -->
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="12"
                                            Foreground="#92400E"
                                            TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="문제: " />
                                            <Run Text="{Binding Problem}" />
                                        </TextBlock>
                                        <!--  원인  -->
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="12"
                                            Foreground="#92400E"
                                            TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="원인: " />
                                            <Run Text="{Binding Cause}" />
                                        </TextBlock>
                                        <!--  해결  -->
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#92400E"
                                            TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="해결: " />
                                            <Run Text="{Binding Solution}" />
                                        </TextBlock>
                                        <!--  성과 / 배운 점  -->
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="#92400E"
                                            TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="성과: " />
                                            <Run Text="{Binding Result}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  새 이슈 입력  -->
                    <Border
                        Margin="0,4,0,0"
                        Padding="12"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#6B7280"
                                Text="+ 이슈 추가" />
                            <!--  문제 입력  -->
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="문제" />
                            <TextBox
                                Height="32"
                                Margin="0,0,0,6"
                                Padding="8,6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Text="{Binding NewIssueProblem, UpdateSourceTrigger=PropertyChanged}" />
                            <!--  원인 입력  -->
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="원인" />
                            <TextBox
                                Height="32"
                                Margin="0,0,0,6"
                                Padding="8,6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Text="{Binding NewIssueCause, UpdateSourceTrigger=PropertyChanged}" />
                            <!--  해결 입력  -->
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="해결" />
                            <TextBox
                                Height="32"
                                Margin="0,0,0,8"
                                Padding="8,6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Text="{Binding NewIssueSolution, UpdateSourceTrigger=PropertyChanged}" />
                            <!--  성과 / 배운 점 입력  -->
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="성과 (선택)" />
                            <TextBox
                                Height="32"
                                Margin="0,0,0,8"
                                Padding="8,6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Text="{Binding NewIssueResult, UpdateSourceTrigger=PropertyChanged}" />
                            <!--  저장 버튼  -->
                            <Button
                                Height="36"
                                Background="#7C3AED"
                                BorderThickness="0"
                                Command="{Binding AddIssueCommand}"
                                Content="저장"
                                Cursor="Hand"
                                Foreground="White" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
        <!--  ▲ 오른쪽 끝  -->

    </Grid>
</UserControl>