<UserControl
    x:Class="Workpace.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Workpace.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Workpace.Views"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  ProgressBar 둥근 모서리 스타일  -->
        <Style x:Key="RoundProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <!--  배경 트랙  -->
                            <Border Background="#E5E7EB" CornerRadius="4" />
                            <!--  채워지는 바 — PART_Track이 전체 너비 기준, PART_Indicator가 실제 채워지는 부분  -->
                            <Border x:Name="PART_Track" CornerRadius="4" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ───────────────────────────────────────
            탭 필터 — 데스크톱 앱 스타일
            하단 보라 언더라인 방식
            선택: 진한 글씨 + 보라 언더라인
            비선택: 회색 글씨, 호버 시 약간 진해짐
            ───────────────────────────────────────
        -->
        <Style x:Key="TabFilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />

            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="Bg"
                                Grid.Row="0"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!--  하단 언더라인 — 비활성 상태는 투명  -->
                            <Border
                                x:Name="Underline"
                                Grid.Row="1"
                                Background="Transparent"
                                CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F9FAFB" />
                                <Setter Property="Foreground" Value="#374151" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  활성 탭 — 보라 언더라인 + 진한 글씨  -->
        <Style
            x:Key="TabFilterButtonActiveStyle"
            BasedOn="{StaticResource TabFilterButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!--  활성 탭 보라 언더라인  -->
                            <Border
                                Grid.Row="1"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ───────────────────────────────────────
            칸반 카드 스타일
            그림자 BlurRadius 줄여서 선명하게
            ───────────────────────────────────────
        -->
        <Style x:Key="KanbanCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#C4B5FD" />
                    <Setter Property="Background" Value="#FAFAFA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  카드 호버 효과 — ListBoxItem에 적용  -->
        <Style x:Key="KanbanListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ListBox 기본 스타일  -->
        <Style x:Key="KanbanListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!--  컬럼 개수 배지  -->
        <Style x:Key="CountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  + 작업 추가 버튼  -->
        <Style x:Key="AddTaskButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="13" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F9FAFB" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  작업 상세 패널 라벨 스타일  -->
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  작업 상세 패널 값 스타일  -->
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <!--  작업 상세 섹션 헤더  -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="32,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!--  ▼ 왼쪽: 칸반 영역  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  1. 헤더  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,24,0,20"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#111827"
                    Text="{Binding CurrentProject.Name}" />
                <Border
                    Margin="12,0,0,0"
                    Padding="12,5"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding DDayText}" />
                </Border>
                <!--  프로젝트 기간 — D-day 뱃지 바로 옆에 보조 텍스트로 표시  -->
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#9CA3AF"
                    Text="{Binding DateRangeText}" />
            </StackPanel>

            <!--  2. 진행률  -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock
                        Width="76"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="현재 진행률:" />
                    <TextBlock
                        Width="38"
                        DockPanel.Dock="Right"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="{Binding CurrentProgressText}"
                        TextAlignment="Right" />
                    <ProgressBar
                        VerticalAlignment="Center"
                        Foreground="{StaticResource PrimaryBrush}"
                        Maximum="100"
                        Minimum="0"
                        Style="{StaticResource RoundProgressBarStyle}"
                        Value="{Binding CurrentProgress}" />
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock
                        Width="76"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#6B7280"
                        Text="목표 진행률:" />
                    <TextBlock
                        Width="38"
                        DockPanel.Dock="Right"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="{Binding TargetProgressText}"
                        TextAlignment="Right" />
                    <ProgressBar
                        VerticalAlignment="Center"
                        Foreground="#9CA3AF"
                        Maximum="100"
                        Minimum="0"
                        Style="{StaticResource RoundProgressBarStyle}"
                        Value="{Binding TargetProgress}" />
                </DockPanel>
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="#EF4444"
                    Text="{Binding PaceWarningText}" />
            </StackPanel>

            <!--  3. 단계 표시  -->
            <!--  원 컬럼: Width="32" 고정 → 창 크기와 무관하게 원이 선에 항상 딱 붙음  -->
            <!--  선 컬럼: Width="*" 유동 → 창이 커지면 선이 늘어나서 공간을 채움  -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <!--  원 행  -->
                    <RowDefinition Height="Auto" />
                    <!--  텍스트 행  -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <!--  기획 원  -->
                    <ColumnDefinition Width="*" />
                    <!--  선 1  -->
                    <ColumnDefinition Width="32" />
                    <!--  설계 원  -->
                    <ColumnDefinition Width="*" />
                    <!--  선 2  -->
                    <ColumnDefinition Width="32" />
                    <!--  개발 원  -->
                    <ColumnDefinition Width="*" />
                    <!--  선 3  -->
                    <ColumnDefinition Width="32" />
                    <!--  테스트 원  -->
                    <ColumnDefinition Width="*" />
                    <!--  선 4  -->
                    <ColumnDefinition Width="32" />
                    <!--  배포 원  -->
                </Grid.ColumnDefinitions>

                <!--  기획  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Background="{Binding IsStage1Done, Converter={StaticResource BoolToStageColorConverter}}"
                    CornerRadius="16">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{StaticResource IconCheck}"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="3" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{Binding IsStage1Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                    Text="기획" />

                <!--  선 1  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="2"
                    VerticalAlignment="Center"
                    Fill="{Binding IsStage1Done, Converter={StaticResource BoolToStageColorConverter}}" />

                <!--  설계  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Background="{Binding IsStage2Done, Converter={StaticResource BoolToStageColorConverter}}"
                    CornerRadius="16">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{StaticResource IconCheck}"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="3" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{Binding IsStage2Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                    Text="설계" />

                <!--  선 2  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="3"
                    Height="2"
                    VerticalAlignment="Center"
                    Fill="{Binding IsStage2Done, Converter={StaticResource BoolToStageColorConverter}}" />

                <!--  개발  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    Background="{Binding IsStage3Done, Converter={StaticResource BoolToStageColorConverter}}"
                    CornerRadius="16">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{StaticResource IconCheck}"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="3" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{Binding IsStage3Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                    Text="개발" />

                <!--  선 3  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="5"
                    Height="2"
                    VerticalAlignment="Center"
                    Fill="{Binding IsStage3Done, Converter={StaticResource BoolToStageColorConverter}}" />

                <!--  테스트  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="6"
                    Width="32"
                    Height="32"
                    Background="{Binding IsStage4Done, Converter={StaticResource BoolToStageColorConverter}}"
                    CornerRadius="16">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{StaticResource IconCheck}"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="3" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="6"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{Binding IsStage4Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                    Text="테스트" />

                <!--  선 4  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="7"
                    Height="2"
                    VerticalAlignment="Center"
                    Fill="{Binding IsStage4Done, Converter={StaticResource BoolToStageColorConverter}}" />

                <!--  배포  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="8"
                    Width="32"
                    Height="32"
                    Background="{Binding IsStage5Done, Converter={StaticResource BoolToStageColorConverter}}"
                    CornerRadius="16">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{StaticResource IconCheck}"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="3" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="8"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{Binding IsStage5Done, Converter={StaticResource BoolToStageForegroundConverter}}"
                    Text="배포" />
            </Grid>

            <!--  4. 탭 필터 — 하단 언더라인 데스크톱 스타일  -->
            <Border
                Grid.Row="3"
                Margin="0,0,0,20"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="TabAll"
                        Command="{Binding FilterCommand}"
                        CommandParameter="전체"
                        Content="전체"
                        Style="{StaticResource TabFilterButtonActiveStyle}" />
                    <Button
                        x:Name="TabPlan"
                        Command="{Binding FilterCommand}"
                        CommandParameter="기획"
                        Content="기획"
                        Style="{StaticResource TabFilterButtonStyle}" />
                    <Button
                        x:Name="TabDesign"
                        Command="{Binding FilterCommand}"
                        CommandParameter="설계"
                        Content="설계"
                        Style="{StaticResource TabFilterButtonStyle}" />
                    <Button
                        x:Name="TabDev"
                        Command="{Binding FilterCommand}"
                        CommandParameter="개발"
                        Content="개발"
                        Style="{StaticResource TabFilterButtonStyle}" />
                    <Button
                        x:Name="TabTest"
                        Command="{Binding FilterCommand}"
                        CommandParameter="테스트"
                        Content="테스트"
                        Style="{StaticResource TabFilterButtonStyle}" />
                    <Button
                        x:Name="TabDeploy"
                        Command="{Binding FilterCommand}"
                        CommandParameter="배포"
                        Content="배포"
                        Style="{StaticResource TabFilterButtonStyle}" />
                </StackPanel>
            </Border>

            <!--  5. 칸반 보드  -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  할일 컬럼  -->
                <StackPanel
                    Grid.Column="0"
                    AllowDrop="True"
                    Drop="Column_Drop"
                    Tag="할일">
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="3"
                                Height="14"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="#9CA3AF"
                                CornerRadius="2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="할 일" />
                            <Border Style="{StaticResource CountBadgeStyle}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#6B7280"
                                    Text="{Binding TodoTasks.Count}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ListBox
                        MaxHeight="380"
                        ItemContainerStyle="{StaticResource KanbanListBoxItemStyle}"
                        ItemsSource="{Binding TodoTasks}"
                        PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Style="{StaticResource KanbanListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource KanbanCardStyle}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                Foreground="#EF4444"
                                                Header="삭제" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleCoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="LockBtnBorder"
                                                            Padding="3"
                                                            Background="Transparent"
                                                            CornerRadius="4">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="24" Height="24">
                                                                    <!--  잠금 상태(IsCore=true)  -->
                                                                    <Path
                                                                        x:Name="IconLocked"
                                                                        Data="{StaticResource IconLock}"
                                                                        Fill="Transparent"
                                                                        Stroke="{StaticResource PrimaryBrush}"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeThickness="2"
                                                                        Visibility="{Binding IsCore, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <!--  잠금 해제 상태(IsCore=false)  -->
                                                                    <Path
                                                                        x:Name="IconUnlocked"
                                                                        Data="{StaticResource IconUnlock}"
                                                                        Fill="Transparent"
                                                                        Stroke="#D1D5DB"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeThickness="2"
                                                                        Visibility="{Binding IsCore, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="LockBtnBorder" Property="Background" Value="#F5F3FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#111827"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                            <Border
                                                Padding="6,3"
                                                Background="{Binding Priority, Converter={StaticResource PriorityToBackgroundConverter}}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Priority, Converter={StaticResource PriorityToForegroundConverter}}"
                                                    Text="{Binding Priority}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding DueDate, Converter={StaticResource NullToCollapsedConverter}}">
                                            <Viewbox
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,4,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path
                                                        Data="{StaticResource IconCalendar}"
                                                        Fill="Transparent"
                                                        Stroke="#9CA3AF"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="2" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding DueDate, StringFormat=M월 d일}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        Command="{Binding AddTaskCommand}"
                        CommandParameter="할일"
                        Content="+ 작업 추가"
                        Style="{StaticResource AddTaskButtonStyle}" />
                </StackPanel>

                <!--  진행중 컬럼  -->
                <StackPanel
                    Grid.Column="2"
                    AllowDrop="True"
                    Drop="Column_Drop"
                    Tag="진행중">
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="3"
                                Height="14"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="진행 중" />
                            <Border Style="{StaticResource CountBadgeStyle}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#6B7280"
                                    Text="{Binding InProgressTasks.Count}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ListBox
                        MaxHeight="380"
                        ItemContainerStyle="{StaticResource KanbanListBoxItemStyle}"
                        ItemsSource="{Binding InProgressTasks}"
                        PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Style="{StaticResource KanbanListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource KanbanCardStyle}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                Foreground="#EF4444"
                                                Header="삭제" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleCoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="LockBtnBorder"
                                                            Padding="3"
                                                            Background="Transparent"
                                                            CornerRadius="4">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="24" Height="24">
                                                                    <!--  잠금 상태(IsCore=true)  -->
                                                                    <Path
                                                                        x:Name="IconLocked"
                                                                        Data="{StaticResource IconLock}"
                                                                        Fill="Transparent"
                                                                        Stroke="{StaticResource PrimaryBrush}"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeThickness="2"
                                                                        Visibility="{Binding IsCore, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <!--  잠금 해제 상태(IsCore=false)  -->
                                                                    <Path
                                                                        x:Name="IconUnlocked"
                                                                        Data="{StaticResource IconUnlock}"
                                                                        Fill="Transparent"
                                                                        Stroke="#D1D5DB"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeThickness="2"
                                                                        Visibility="{Binding IsCore, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="LockBtnBorder" Property="Background" Value="#F5F3FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#111827"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                            <Border
                                                Padding="6,3"
                                                Background="{Binding Priority, Converter={StaticResource PriorityToBackgroundConverter}}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Priority, Converter={StaticResource PriorityToForegroundConverter}}"
                                                    Text="{Binding Priority}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding DueDate, Converter={StaticResource NullToCollapsedConverter}}">
                                            <Viewbox
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,4,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path
                                                        Data="{StaticResource IconCalendar}"
                                                        Fill="Transparent"
                                                        Stroke="#9CA3AF"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="2" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding DueDate, StringFormat=M월 d일}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        Command="{Binding AddTaskCommand}"
                        CommandParameter="진행중"
                        Content="+ 작업 추가"
                        Style="{StaticResource AddTaskButtonStyle}" />
                </StackPanel>

                <!--  완료 컬럼  -->
                <StackPanel
                    Grid.Column="4"
                    AllowDrop="True"
                    Drop="Column_Drop"
                    Tag="완료">
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="3"
                                Height="14"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="#10B981"
                                CornerRadius="2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="완료" />
                            <Border Style="{StaticResource CountBadgeStyle}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#6B7280"
                                    Text="{Binding DoneTasks.Count}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ListBox
                        MaxHeight="380"
                        ItemContainerStyle="{StaticResource KanbanListBoxItemStyle}"
                        ItemsSource="{Binding DoneTasks}"
                        PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Style="{StaticResource KanbanListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource KanbanCardStyle}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                Foreground="#EF4444"
                                                Header="삭제" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleCoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="LockBtnBorder"
                                                            Padding="3"
                                                            Background="Transparent"
                                                            CornerRadius="4">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="24" Height="24">
                                                                    <!--  잠금 상태(IsCore=true)  -->
                                                                    <Path
                                                                        x:Name="IconLocked"
                                                                        Data="{StaticResource IconLock}"
                                                                        Fill="Transparent"
                                                                        Stroke="{StaticResource PrimaryBrush}"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeThickness="2"
                                                                        Visibility="{Binding IsCore, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <!--  잠금 해제 상태(IsCore=false)  -->
                                                                    <Path
                                                                        x:Name="IconUnlocked"
                                                                        Data="{StaticResource IconUnlock}"
                                                                        Fill="Transparent"
                                                                        Stroke="#D1D5DB"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeThickness="2"
                                                                        Visibility="{Binding IsCore, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="LockBtnBorder" Property="Background" Value="#F5F3FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#9CA3AF"
                                                Text="{Binding Title}"
                                                TextDecorations="Strikethrough"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                            <Border
                                                Padding="6,3"
                                                Background="#D1FAE5"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#065F46"
                                                    Text="완료" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding DueDate, Converter={StaticResource NullToCollapsedConverter}}">
                                            <Viewbox
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,4,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path
                                                        Data="{StaticResource IconCalendar}"
                                                        Fill="Transparent"
                                                        Stroke="#9CA3AF"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="2" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding DueDate, StringFormat=M월 d일}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        Command="{Binding AddTaskCommand}"
                        CommandParameter="완료"
                        Content="+ 작업 추가"
                        Style="{StaticResource AddTaskButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
        <!--  ▲ 왼쪽 끝  -->

        <!--  ▼ 오른쪽: 작업 상세 패널 — 사이드바 형태  -->
        <Border
            Grid.Column="1"
            Margin="20,0,0,0"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1,0,0,0"
            Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  헤더 고정 영역  -->
                <Border
                    Grid.Row="0"
                    Padding="20,16,20,0"
                    BorderBrush="#F3F4F6"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  작업 상세 레이블 + X버튼 우측 상단 고정  -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <Button
                                Width="28"
                                Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding CloseDetailPanelCommand}"
                                Cursor="Hand"
                                DockPanel.Dock="Right">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Root"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <Viewbox Width="14" Height="14">
                                                <Canvas Width="24" Height="24">
                                                    <Path
                                                        Data="{StaticResource IconX}"
                                                        Fill="Transparent"
                                                        Stroke="#6B7280"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="2" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#F3F4F6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#374151"
                                Text="작업 상세" />
                        </DockPanel>

                        <!--  제목 + 연필 아이콘 바로 옆  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,16"
                            Orientation="Horizontal"
                            Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#111827"
                                Text="{Binding SelectedTask.Title}"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding StartEditCommand}"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Root"
                                            Padding="5"
                                            Background="Transparent"
                                            CornerRadius="4">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <Path
                                                        Data="{StaticResource IconPencil}"
                                                        Fill="Transparent"
                                                        Stroke="#6B7280"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="2" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#F3F4F6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  스크롤 가능한 내용 영역  -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">

                        <!--  ── 보기 모드 ──  -->
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                            <!--  뱃지 행 — 상태/우선순위/단계  -->
                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <Border
                                    Margin="0,0,6,0"
                                    Padding="10,4"
                                    Background="#EDE9FE"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="{Binding SelectedTask.Status}" />
                                </Border>
                                <Border
                                    Margin="0,0,6,0"
                                    Padding="10,4"
                                    Background="{Binding SelectedTask.Priority, Converter={StaticResource PriorityToBackgroundConverter}}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding SelectedTask.Priority, Converter={StaticResource PriorityToForegroundConverter}}"
                                        Text="{Binding SelectedTask.Priority}" />
                                </Border>
                                <Border
                                    Padding="10,4"
                                    Background="#F3F4F6"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="#374151"
                                        Text="{Binding SelectedTask.Stage}" />
                                </Border>
                            </StackPanel>

                            <!--  마감일 행 — 없으면 숨김  -->
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Visibility="{Binding SelectedTask.DueDate, Converter={StaticResource NullToCollapsedConverter}}">
                                <Viewbox
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path
                                            Data="{StaticResource IconCalendar}"
                                            Fill="Transparent"
                                            Stroke="#9CA3AF"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#6B7280"
                                    Text="{Binding SelectedTask.DueDate, StringFormat=yyyy년 M월 d일}" />
                            </StackPanel>

                            <!--  설명 — 있을 때만 표시  -->
                            <StackPanel Margin="0,0,0,16" Visibility="{Binding SelectedTask.Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#374151"
                                    Text="{Binding SelectedTask.Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                        </StackPanel>

                        <!--  ── 수정 모드 ──  -->
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!--  헤더  -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#111827"
                                    Text="작업 수정" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding CancelEditCommand}"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="6">
                                                <Viewbox Width="14" Height="14">
                                                    <Canvas Width="24" Height="24">
                                                        <Path
                                                            x:Name="CloseIcon"
                                                            Data="{StaticResource IconX}"
                                                            Fill="Transparent"
                                                            Stroke="#9CA3AF"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="2" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#F3F4F6" />
                                                    <Setter TargetName="CloseIcon" Property="Stroke" Value="#374151" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!--  제목  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="제목" />
                            <TextBox
                                Height="38"
                                Margin="0,0,0,16"
                                Padding="12,8"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                FontSize="13"
                                Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!--  설명  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="설명" />
                            <TextBox
                                Height="70"
                                Margin="0,0,0,16"
                                Padding="12,8"
                                AcceptsReturn="True"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                FontSize="13"
                                Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!--  우선순위  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="우선순위" />
                            <ComboBox
                                Margin="0,0,0,16"
                                SelectedValue="{Binding EditPriority}"
                                SelectedValuePath="Content">
                                <ComboBoxItem Content="높음" />
                                <ComboBoxItem Content="보통" />
                                <ComboBoxItem Content="낮음" />
                            </ComboBox>

                            <!--  단계  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="단계" />
                            <ComboBox
                                Margin="0,0,0,16"
                                SelectedValue="{Binding EditStage}"
                                SelectedValuePath="Content">
                                <ComboBoxItem Content="기획" />
                                <ComboBoxItem Content="설계" />
                                <ComboBoxItem Content="개발" />
                                <ComboBoxItem Content="테스트" />
                                <ComboBoxItem Content="배포" />
                            </ComboBox>

                            <!--  마감일  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="마감일" />
                            <views:CustomDatePicker Margin="0,0,0,24" SelectedDate="{Binding EditDueDate}" />

                            <!--  저장/취소 버튼  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Height="40"
                                    Cursor="Hand"
                                    FontSize="13"
                                    Foreground="#6B7280">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Root"
                                                Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#F9FAFB" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Content>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#6B7280"
                                            Text="취소" />
                                    </Button.Content>
                                    <Button.Command>
                                        <Binding Path="CancelEditCommand" />
                                    </Button.Command>
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Height="40"
                                    Command="{Binding SaveEditCommand}"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Root"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#6D28D9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Content>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="저장" />
                                    </Button.Content>
                                </Button>
                            </Grid>

                        </StackPanel>

                        <!--  구분선  -->
                        <Rectangle
                            Height="1"
                            Margin="0,16,0,16"
                            Fill="#F3F4F6" />

                        <!--  연결된 파일  -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="연결된 파일" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="{Binding CurrentFiles.Count, StringFormat=({0}개)}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding CurrentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,6"
                                        Padding="10,8"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <DockPanel>
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Source="{Binding FileName, Converter={StaticResource FileIconConverter}}" />
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right"
                                                FontSize="11"
                                                Foreground="#EF4444">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="Root"
                                                            Padding="4,2"
                                                            Background="Transparent"
                                                            CornerRadius="4">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="#EF4444"
                                                                Text="✕" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="#FEE2E2" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                FontSize="12"
                                                Foreground="#374151"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        MouseAction="LeftClick" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            Height="34"
                            Margin="0,4,0,0"
                            Background="Transparent"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Command="{Binding AddFileCommand}"
                            Cursor="Hand"
                            FontSize="12"
                            Foreground="#9CA3AF">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#9CA3AF"
                                            Text="+ 파일 추가" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#F9FAFB" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="#D1D5DB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!--  구분선  -->
                        <Rectangle
                            Height="1"
                            Margin="0,16,0,16"
                            Fill="#F3F4F6" />

                        <!--  이슈 기록  -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="이슈 기록" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="{Binding CurrentIssues.Count, StringFormat=({0}건)}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding CurrentIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        Background="White"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    DockPanel.Dock="Right">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="Root"
                                                                Background="Transparent"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    Foreground="#9CA3AF"
                                                                    Text="✕" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Root" Property="Background" Value="#FEE2E2" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#111827"
                                                    Text="{Binding Problem}"
                                                    TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="12"
                                                Foreground="#6B7280"
                                                TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="원인 : " /><Run Text="{Binding Cause}" />
                                            </TextBlock>
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontSize="12"
                                                Foreground="#6B7280"
                                                TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="해결 : " /><Run Text="{Binding Solution}" />
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding CreatedAt, StringFormat=yyyy.MM.dd}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  새 이슈 입력  -->
                        <Border
                            Margin="0,4,0,0"
                            Padding="14"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#374151"
                                    Text="+ 이슈 추가" />

                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#9CA3AF"
                                    Text="문제" />
                                <TextBox
                                    Height="32"
                                    Margin="0,0,0,8"
                                    Padding="10,6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    FontSize="12"
                                    Text="{Binding NewIssueProblem, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#9CA3AF"
                                    Text="원인" />
                                <TextBox
                                    Height="32"
                                    Margin="0,0,0,8"
                                    Padding="10,6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    FontSize="12"
                                    Text="{Binding NewIssueCause, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#9CA3AF"
                                    Text="해결" />
                                <TextBox
                                    Height="32"
                                    Margin="0,0,0,8"
                                    Padding="10,6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    FontSize="12"
                                    Text="{Binding NewIssueSolution, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#9CA3AF"
                                    Text="성과 (선택)" />
                                <TextBox
                                    Height="32"
                                    Margin="0,0,0,12"
                                    Padding="10,6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    FontSize="12"
                                    Text="{Binding NewIssueResult, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <Button
                                    Height="38"
                                    Command="{Binding AddIssueCommand}"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Root"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="저장" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#6D28D9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <!--  ▲ 오른쪽 끝  -->

    </Grid>
</UserControl>