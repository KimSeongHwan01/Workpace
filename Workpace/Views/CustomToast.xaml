<Window
    x:Class="Workpace.Views.CustomToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="340"
    Height="Auto"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Border
        Padding="16"
        Background="White"
        BorderBrush="#DDD6FE"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Opacity="0.15"
                ShadowDepth="2"
                Color="#7C3AED" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="48"
                Height="48"
                Margin="0,0,14,0"
                VerticalAlignment="Top"
                Background="#F5F3FF"
                CornerRadius="10">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Text="{Binding Icon}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Width="20"
                Height="20"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseButton_Click"
                Content="✕"
                Cursor="Hand"
                FontSize="11"
                Foreground="#9CA3AF" />
        </Grid>
    </Border>
</Window>