<Window x:Class="Workpace.Views.AddProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="새 프로젝트 추가" Height="480" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0" Text="새 프로젝트" 
                   FontSize="20" FontWeight="Bold"
                   Foreground="#1F1F1F" Margin="0,0,0,24"/>

        <!-- 프로젝트 이름 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="프로젝트 이름 *" FontSize="13"
                       Foreground="#6B7280" Margin="0,0,0,6"/>
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" Padding="10,8"
                     BorderBrush="#E5E7EB" BorderThickness="1"/>
        </StackPanel>

        <!-- 프로젝트 유형 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="프로젝트 유형" FontSize="13"
                       Foreground="#6B7280" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding ProjectTypes}"
                      SelectedItem="{Binding SelectedType}"
                      Height="36" Padding="10,8"
                      BorderBrush="#E5E7EB" BorderThickness="1"/>
        </StackPanel>

        <!-- 시작일 / 마감일 -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 시작일 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="시작일" FontSize="13"
                           Foreground="#6B7280" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding StartDate}"
                            Height="36" BorderBrush="#E5E7EB"/>
            </StackPanel>

            <!-- 마감일 -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="마감일" FontSize="13"
                           Foreground="#6B7280" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding Deadline}"
                            Height="36" BorderBrush="#E5E7EB"/>
            </StackPanel>
        </Grid>

        <!-- GitHub URL -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="GitHub URL (선택)" FontSize="13"
                       Foreground="#6B7280" Margin="0,0,0,6"/>
            <TextBox Text="{Binding GitHubUrl, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" Padding="10,8"
                     BorderBrush="#E5E7EB" BorderThickness="1"/>
        </StackPanel>

        <!-- 설명 -->
        <StackPanel Grid.Row="5" Margin="0,0,0,16">
            <TextBlock Text="설명 (선택)" FontSize="13"
                       Foreground="#6B7280" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Height="72" Padding="10,8"
                     BorderBrush="#E5E7EB" BorderThickness="1"
                     TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <!-- 확인 / 취소 버튼 -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 취소 -->
            <Button Grid.Column="0" Content="취소"
                    Height="40" BorderThickness="1"
                    BorderBrush="#E5E7EB" Background="White"
                    Command="{Binding CancelCommand}"
                    Cursor="Hand"/>

            <!-- 확인 -->
            <Button Grid.Column="2" Content="확인"
                    Height="40" BorderThickness="0"
                    Background="#7C3AED" Foreground="White"
                    Command="{Binding ConfirmCommand}"
                    Cursor="Hand"/>
        </Grid>

    </Grid>
</Window>