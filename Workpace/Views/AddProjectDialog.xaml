<Window
    x:Class="Workpace.Views.AddProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="새 프로젝트 만들기"
    Width="600"
    Height="700"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  제목  -->
            <RowDefinition Height="*" />
            <!--  스크롤 영역  -->
            <RowDefinition Height="Auto" />
            <!--  버튼  -->
        </Grid.RowDefinitions>

        <!--  제목  -->
        <Border Grid.Row="0" Padding="32,24,32,0">
            <StackPanel>
                <TextBlock
                    x:Name="HeaderTitleText"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="새 프로젝트 만들기" />
                <TextBlock
                    x:Name="HeaderSubtitleText"
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#9CA3AF"
                    Text="프로젝트를 시작하고, 끝까지 완주하세요." />
            </StackPanel>
        </Border>

        <!--  스크롤 영역 — 내용이 많아서 스크롤 가능하게  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="32,20,32,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ① 프로젝트 기본 정보  -->
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <Border
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="11">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="1" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#1F1F1F"
                        Text="프로젝트 기본 정보" />
                </StackPanel>

                <!--  프로젝트 이름  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="프로젝트명 *" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />

                <!--  부제 / 설명  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="부제 / 설명" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <!--  시작일 / 마감일  -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="시작일 *" />
                        <DatePicker
                            Height="36"
                            BorderBrush="#E5E7EB"
                            SelectedDate="{Binding StartDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="마감일 *" />
                        <DatePicker
                            Height="36"
                            BorderBrush="#E5E7EB"
                            SelectedDate="{Binding Deadline}" />
                    </StackPanel>
                </Grid>

                <!--  GitHub URL  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="GitHub 링크" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding GitHubUrl, UpdateSourceTrigger=PropertyChanged}" />

                <!--  개발 배경  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="개발 배경 (한 줄 설명)" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,24"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" />

                <!--  ② 기술 스택 선택  -->
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <Border
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="11">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="2" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#1F1F1F"
                        Text="기술 스택 선택 (복수 선택 가능)" />
                </StackPanel>

                <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding TechStacks}">
                    <ItemsControl.ItemsPanel>
                        <!--  WrapPanel — 공간 부족하면 자동 줄바꿈  -->
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Margin="0,0,8,8"
                                Padding="12,6"
                                Content="{Binding Name}"
                                IsChecked="{Binding IsSelected}"
                                Style="{StaticResource TechStackToggleStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  + 기타 추가 버튼 — 입력 중이 아닐 때만 표시  -->
                <Button
                    Margin="0,0,0,24"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Command="{Binding ShowAddTechStackCommand}"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path
                                                x:Name="PlusIcon"
                                                Data="{StaticResource IconPlus}"
                                                Fill="Transparent"
                                                Stroke="#6B7280"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="2" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="BtnText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#6B7280"
                                        Text="기타 추가" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F5F3FF" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C4B5FD" />
                                    <Setter TargetName="PlusIcon" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                    <Setter TargetName="BtnText" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddingTechStack}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!--  기타 추가 입력창 — "+ 기타 추가" 클릭 시에만 표시  -->
                <Grid Margin="0,0,0,24">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddingTechStack}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Height="32"
                        Padding="8,6"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Text="{Binding NewTechStackInput, UpdateSourceTrigger=PropertyChanged}">
                        <!--  Enter 키로도 추가되게  -->
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCustomTechStackCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button
                        Grid.Column="2"
                        Height="32"
                        Padding="14,0"
                        Background="{StaticResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding AddCustomTechStackCommand}"
                        Content="추가"
                        Cursor="Hand"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#6D28D9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        Grid.Column="4"
                        Height="32"
                        Padding="14,0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Command="{Binding CancelAddTechStackCommand}"
                        Content="취소"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F9FAFB" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!--  ③ 포트폴리오 정보  -->
                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                    <Border
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        Background="#E5E7EB"
                        CornerRadius="11">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#6B7280"
                            Text="3" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#1F1F1F"
                        Text="포트폴리오 정보 (선택)" />
                </StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="12"
                    Foreground="#9CA3AF"
                    Text="입력할수록 포트폴리오가 풍부해져요." />

                <!--  기술 스택 선정 이유  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="기술 스택 선정 이유" />
                <TextBox
                    Height="60"
                    Margin="0,0,0,4"
                    Padding="10,8"
                    AcceptsReturn="True"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding TechReason, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="11"
                    Foreground="#9CA3AF"
                    Text="예) C#은 WPF와 호환성이 좋아서, SQLite는 로컬 저장에 적합해서" />

                <!--  참여 인원 및 역할  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="참여 인원 및 본인 역할" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,4"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="11"
                    Foreground="#9CA3AF"
                    Text="예) 1인 개발 / 기획·설계·개발·테스트 전담" />

                <!--  아키텍처 설명  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="아키텍처 설명" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,4"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Architecture, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,0,0,24"
                    FontSize="11"
                    Foreground="#9CA3AF"
                    Text="예) MVVM 패턴, SQLite 로컬 저장, WPF 네이티브 UI" />

            </StackPanel>
        </ScrollViewer>

        <!--  확인 / 취소 버튼  -->
        <Border Grid.Row="2" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="40"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"
                    Content="취소"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F9FAFB" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    x:Name="ConfirmButton"
                    Grid.Column="2"
                    Height="40"
                    Background="{StaticResource PrimaryBrush}"
                    BorderThickness="0"
                    Command="{Binding ConfirmCommand}"
                    Cursor="Hand"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#6D28D9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox
                            Width="15"
                            Height="15"
                            Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{StaticResource IconSparkles}"
                                    Fill="Transparent"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock VerticalAlignment="Center" Text="프로젝트 시작하기" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>