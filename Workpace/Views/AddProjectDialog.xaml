<Window
    x:Class="Workpace.Views.AddProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="새 프로젝트 만들기"
    Width="600"
    Height="700"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  제목  -->
            <RowDefinition Height="*" />
            <!--  스크롤 영역  -->
            <RowDefinition Height="Auto" />
            <!--  버튼  -->
        </Grid.RowDefinitions>

        <!--  제목  -->
        <Border Grid.Row="0" Padding="32,24,32,0">
            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="새 프로젝트 만들기" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#9CA3AF"
                    Text="프로젝트를 시작하고, 끝까지 완주하세요." />
            </StackPanel>
        </Border>

        <!--  스크롤 영역 — 내용이 많아서 스크롤 가능하게  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="32,20,32,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ① 프로젝트 기본 정보  -->
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="① 프로젝트 기본 정보" />

                <!--  프로젝트 이름  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="프로젝트명 *" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />

                <!--  부제 / 설명  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="부제 / 설명" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <!--  시작일 / 마감일  -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="시작일 *" />
                        <DatePicker
                            Height="36"
                            BorderBrush="#E5E7EB"
                            SelectedDate="{Binding StartDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="마감일 *" />
                        <DatePicker
                            Height="36"
                            BorderBrush="#E5E7EB"
                            SelectedDate="{Binding Deadline}" />
                    </StackPanel>
                </Grid>

                <!--  GitHub URL  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="GitHub 링크 (선택)" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding GitHubUrl, UpdateSourceTrigger=PropertyChanged}" />

                <!--  개발 배경  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="개발 배경 (한 줄 설명) *" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,24"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" />

                <!--  ② 기술 스택 선택  -->
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="② 기술 스택 선택 (복수 선택 가능)" />

                <ItemsControl Margin="0,0,0,24" ItemsSource="{Binding TechStacks}">
                    <ItemsControl.ItemsPanel>
                        <!--  WrapPanel — 공간 부족하면 자동 줄바꿈  -->
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Margin="0,0,8,8"
                                Padding="12,6"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Content="{Binding Name}"
                                Cursor="Hand"
                                IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  ③ 프로젝트 유형 선택  -->
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="③ 프로젝트 유형 선택" />

                <UniformGrid
                    Margin="0,0,0,24"
                    Columns="5"
                    Rows="1">

                    <!--  소프트웨어 개발  -->
                    <RadioButton
                        GroupName="ProjectType"
                        IsChecked="{Binding SelectedType, Converter={StaticResource EqualityConverter}, ConverterParameter=소프트웨어개발}"
                        Style="{StaticResource TypeCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Text="💻" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                Text="소프트웨어 개발"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <!--  디자인  -->
                    <RadioButton
                        GroupName="ProjectType"
                        IsChecked="{Binding SelectedType, Converter={StaticResource EqualityConverter}, ConverterParameter=디자인}"
                        Style="{StaticResource TypeCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Text="🎨" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                Text="디자인 프로젝트"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <!--  학교 과제  -->
                    <RadioButton
                        GroupName="ProjectType"
                        IsChecked="{Binding SelectedType, Converter={StaticResource EqualityConverter}, ConverterParameter=학교과제}"
                        Style="{StaticResource TypeCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Text="📚" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                Text="학교 과제"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <!--  직장 업무  -->
                    <RadioButton
                        GroupName="ProjectType"
                        IsChecked="{Binding SelectedType, Converter={StaticResource EqualityConverter}, ConverterParameter=직장업무}"
                        Style="{StaticResource TypeCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Text="💼" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                Text="직장 업무"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <!--  개인 목표  -->
                    <RadioButton
                        GroupName="ProjectType"
                        IsChecked="{Binding SelectedType, Converter={StaticResource EqualityConverter}, ConverterParameter=개인목표}"
                        Style="{StaticResource TypeCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Text="🎯" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                Text="개인 목표"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                </UniformGrid>

                <!--  ④ 포트폴리오 강화 정보  -->
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="④ 포트폴리오 정보 (선택)" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="12"
                    Foreground="#9CA3AF"
                    Text="입력할수록 포트폴리오가 풍부해져요." />

                <!--  기술 스택 선정 이유  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="기술 스택 선정 이유" />
                <TextBox
                    Height="60"
                    Margin="0,0,0,4"
                    Padding="10,8"
                    AcceptsReturn="True"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding TechReason, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="11"
                    Foreground="#9CA3AF"
                    Text="예) C#은 WPF와 호환성이 좋아서, SQLite는 로컬 저장에 적합해서" />

                <!--  참여 인원 및 역할  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="참여 인원 및 본인 역할" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,4"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="11"
                    Foreground="#9CA3AF"
                    Text="예) 1인 개발 / 기획·설계·개발·테스트 전담" />

                <!--  아키텍처 설명  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="아키텍처 설명" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,4"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Architecture, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,0,0,24"
                    FontSize="11"
                    Foreground="#9CA3AF"
                    Text="예) MVVM 패턴, SQLite 로컬 저장, WPF 네이티브 UI" />

            </StackPanel>
        </ScrollViewer>

        <!--  확인 / 취소 버튼  -->
        <Border Grid.Row="2" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="40"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"
                    Content="취소"
                    Cursor="Hand" />

                <Button
                    Grid.Column="2"
                    Height="40"
                    Background="#7C3AED"
                    BorderThickness="0"
                    Command="{Binding ConfirmCommand}"
                    Content="🚀 프로젝트 시작하기"
                    Cursor="Hand"
                    Foreground="White" />
            </Grid>
        </Border>

    </Grid>
</Window>