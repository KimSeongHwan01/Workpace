<Window x:Class="Workpace.Views.AddTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="작업 추가" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <Border Grid.Row="0" Padding="32,24,32,0">
            <StackPanel>
                <TextBlock Text="작업 추가"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#1F1F1F"/>
                <TextBlock Text="새로운 작업을 추가하세요."
                           FontSize="13" Foreground="#9CA3AF"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 입력 영역 -->
        <ScrollViewer Grid.Row="1" Padding="32,20,32,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 작업 이름 -->
                <TextBlock Text="작업 이름 *" FontSize="13"
                           Foreground="#6B7280" Margin="0,0,0,6"/>
                <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" Padding="10,8"
                         BorderBrush="#E5E7EB" BorderThickness="1"
                         Margin="0,0,0,16"/>

                <!-- 우선순위 -->
                <TextBlock Text="우선순위" FontSize="13"
                           Foreground="#6B7280" Margin="0,0,0,6"/>
                <ComboBox SelectedItem="{Binding Priority}"
                          Height="36" Padding="10,8"
                          BorderBrush="#E5E7EB" BorderThickness="1"
                          Margin="0,0,0,16">
                    <ComboBoxItem Content="높음"/>
                    <ComboBoxItem Content="보통"/>
                    <ComboBoxItem Content="낮음"/>
                </ComboBox>

                <!-- 단계 -->
                <TextBlock Text="단계" FontSize="13"
                           Foreground="#6B7280" Margin="0,0,0,6"/>
                <ComboBox SelectedItem="{Binding Stage}"
                          Height="36" Padding="10,8"
                          BorderBrush="#E5E7EB" BorderThickness="1"
                          Margin="0,0,0,16">
                    <ComboBoxItem Content="기획"/>
                    <ComboBoxItem Content="설계"/>
                    <ComboBoxItem Content="개발"/>
                    <ComboBoxItem Content="테스트"/>
                    <ComboBoxItem Content="완료"/>
                </ComboBox>

                <!-- 마감일 -->
                <TextBlock Text="마감일 (선택)" FontSize="13"
                           Foreground="#6B7280" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding Duedate}"
                            Height="36" BorderBrush="#E5E7EB"
                            Margin="0,0,0,16"/>

            </StackPanel>
        </ScrollViewer>

        <!-- 확인 / 취소 버튼 -->
        <Border Grid.Row="2" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="취소"
                        Height="40" BorderThickness="1"
                        BorderBrush="#E5E7EB" Background="White"
                        Command="{Binding CancelCommand}"
                        Cursor="Hand"/>

                <Button Grid.Column="2" Content="작업 추가"
                        Height="40" BorderThickness="0"
                        Background="#7C3AED" Foreground="White"
                        Command="{Binding ConfirmCommand}"
                        Cursor="Hand"/>
            </Grid>
        </Border>

    </Grid>
</Window>