<Window
    x:Class="Workpace.Views.AddTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="작업 추가"
    Width="480"
    Height="420"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  제목  -->
        <Border Grid.Row="0" Padding="32,24,32,0">
            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#1F1F1F"
                    Text="작업 추가" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#9CA3AF"
                    Text="새로운 작업을 추가하세요." />
            </StackPanel>
        </Border>

        <!--  입력 영역  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="32,20,32,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  작업 이름  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="작업 이름 *" />
                <TextBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" />

                <!--  작업 설명  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="작업 설명 (선택)" />
                <TextBox
                    Height="70"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    AcceptsReturn="True"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <!--  우선순위  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="우선순위" />
                <ComboBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    SelectedValue="{Binding Priority}"
                    SelectedValuePath="Content">
                    <ComboBoxItem Content="높음" />
                    <ComboBoxItem Content="보통" />
                    <ComboBoxItem Content="낮음" />
                </ComboBox>

                <!--  단계  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="단계" />
                <ComboBox
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    SelectedValue="{Binding Stage}"
                    SelectedValuePath="Content">
                    <ComboBoxItem Content="기획" />
                    <ComboBoxItem Content="설계" />
                    <ComboBoxItem Content="개발" />
                    <ComboBoxItem Content="테스트" />
                    <ComboBoxItem Content="배포" />
                </ComboBox>

                <!--  마감일  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="마감일 (선택)" />
                <DatePicker
                    Height="36"
                    Margin="0,0,0,16"
                    BorderBrush="#E5E7EB"
                    SelectedDate="{Binding Duedate}" />

            </StackPanel>
        </ScrollViewer>

        <!--  확인 / 취소 버튼  -->
        <Border Grid.Row="2" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="40"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"
                    Content="취소"
                    Cursor="Hand" />

                <Button
                    Grid.Column="2"
                    Height="40"
                    Background="#7C3AED"
                    BorderThickness="0"
                    Command="{Binding ConfirmCommand}"
                    Content="작업 추가"
                    Cursor="Hand"
                    Foreground="White" />
            </Grid>
        </Border>

    </Grid>
</Window>