<Window
    x:Class="Workpace.Views.RetrospectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="프로젝트 회고"
    Width="500"
    Height="560"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  제목  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="#1F1F1F"
                Text="🎉 프로젝트 완료를 축하해요!" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="#9CA3AF"
                Text="짧게 회고를 남기면 포트폴리오에 자동으로 반영돼요." />
        </StackPanel>

        <!--  입력 영역  -->
        <StackPanel Grid.Row="1">

            <!--  배운 점  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="13"
                Foreground="#6B7280"
                Text="배운 점" />
            <TextBox
                x:Name="LearnBox"
                Height="72"
                Margin="0,0,0,16"
                Padding="10,8"
                AcceptsReturn="True"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                TextWrapping="Wrap" />

            <!--  아쉬운 점  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="13"
                Foreground="#6B7280"
                Text="아쉬운 점" />
            <TextBox
                x:Name="RegretBox"
                Height="72"
                Margin="0,0,0,16"
                Padding="10,8"
                AcceptsReturn="True"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                TextWrapping="Wrap" />

            <!--  개선 방향  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="13"
                Foreground="#6B7280"
                Text="개선할 점" />
            <TextBox
                x:Name="ImproveBox"
                Height="72"
                Margin="0,0,0,0"
                Padding="10,8"
                AcceptsReturn="True"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                TextWrapping="Wrap" />

        </StackPanel>

        <!--  버튼  -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="40"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Click="LaterButton_Click"
                Content="나중에"
                Cursor="Hand" />

            <Button
                Grid.Column="2"
                Height="40"
                Background="#7C3AED"
                BorderThickness="0"
                Click="SaveButton_Click"
                Content="💾 저장하기"
                Cursor="Hand"
                Foreground="White" />
        </Grid>
    </Grid>
</Window>